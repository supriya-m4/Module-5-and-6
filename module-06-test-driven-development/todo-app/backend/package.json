{
  "name": "todo-backend",
  "version": "1.0.0",
  "description": "A lightweight Node/Express API for persisting ToDo tasks.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --runInBand",
    "test:unit": "jest tests/toggleCompletion.test.js --runInBand",
    "test:integration": "jest tests/tasks.integration.test.js --runInBand",
    "test:api": "newman run tests/postman/todo-api.postman_collection.json -e tests/postman/todo-api.postman_environment.json",
    "test:performance": "k6 run tests/performance/tasks-post-load.k6.js",
    "test:all": "powershell -ExecutionPolicy Bypass -File tests/run-backend-tests.ps1"
  },
  "engines": {
    "node": ">=16"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "nodemon": "^2.0.22"
  }
}
